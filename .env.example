# Environment variables for the adapter (copy to .env for local dev)

# Deployment
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080

# Infrastructure — optional accelerators, empty = in-process fallback.
# compose ships no redis/minio containers; point these at a managed service to
# use them. Leaving them empty is better than an unreachable host, which makes
# every call pay a connect timeout first.
#   REDIS_URL empty      -> state chain + asset cache live in the worker
#                           (single-node only: workers do not share state)
#   MINIO_ENDPOINT empty -> ctx.image_url() returns a data URI instead of a
#                           presigned public URL
REDIS_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=adapter-temp
MINIO_SECURE=false

# Timeouts
UPSTREAM_TIMEOUT=60.0
POLL_TIMEOUT_DEFAULT=120.0
POLL_INTERVAL_DEFAULT=2.0

# Admission control（X-Adapter-Key 门禁）
# 字段名是 ADAPTER_KEY / ADAPTER_KEY_REQUIRED，不是 ADAPTER_AUTH_*。
# ADAPTER_KEY_REQUIRED 默认 true；此时 ADAPTER_KEY 若为空，所有请求一律 401。
# 内联脚本即远程代码执行，生产环境必须设 ADAPTER_KEY 而不是关掉门禁。
ADAPTER_KEY_REQUIRED=false
ADAPTER_KEY=

# Rate Limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ALLOW_ORIGINS=*

# Observability (optional; leave blank for local-only mode)
LOGFIRE_TOKEN=

# 上游凭据不从这里读取。适配器不持有上游密钥：脚本无法访问进程环境
# （见 adapter/context.py 模块注释），凭据由控制面随请求经 channel header 传入
# （Authorization / X-Auth-Emit）。
# 下面这个仅供人工用 curl 直连火山方舟时 source 使用，适配器本身不消费。
VOLCENGINE_ARK_API_KEY=

# --- gunicorn（仅容器内生效，见 gunicorn.conf.py）-------------------------
# 这些不是 Settings 字段，适配器进程不读；由 gunicorn 启动时读取。
# 留空即用默认：worker 数 = CPU 核数。
# WEB_CONCURRENCY 是覆盖 worker 数的标准变量，一份镜像可适配不同规格机器。
WEB_CONCURRENCY=
# worker 存活看门狗，必须大于 UPSTREAM_TIMEOUT，否则慢生成会被 SIGKILL 成 502。
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=120
# 单 worker 并发连接上限；真正的节流是 HTTP_POOL_LIMIT。
WORKER_CONNECTIONS=1000
