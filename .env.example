# Environment variables for the adapter (copy to .env for local dev)

# Deployment
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080

# Infrastructure — optional accelerators, empty = in-process fallback.
# REDIS_URL is one switch across three states:
#   redis://redis:6379/0   -> the built-in redis service in compose (default)
#   redis://<host>:6379/0  -> an external / managed redis
#   empty                  -> state chain + asset cache live in the worker
#                             (single-node only: workers do NOT share state)
# Required as soon as WEB_CONCURRENCY > 1: with no shared store the
# /v1/responses state chain breaks silently across workers. A configured but
# unreachable host now degrades to the in-process fallback (30s backoff)
# instead of failing requests, so it is survivable -- but leaving it empty is
# still the honest choice when you run a single worker.
# MINIO_ENDPOINT empty -> ctx.image_url() returns a data URI instead of a
#                         presigned public URL
REDIS_URL=redis://redis:6379/0
# Which object store to use. The backends differ in protocol, not just address:
#   minio         S3-compatible; upload returns a PRESIGNED url that expires
#                 after TEMP_IMAGE_TTL (7 days at most, see below)
#   minio_public  the SAME bucket, read anonymously: a plain url with no
#                 signature, so there is no expiry to reach. Needs the storage
#                 side to allow anonymous s3:GetObject on the bucket -- ping
#                 reads the policy, so a private bucket reports degraded
#                 instead of handing out links that 403. Everything uploaded
#                 this way is PUBLIC and cannot be unpublished.
#   minio_colocated  the SAME bucket at two addresses: uploads try
#                 MINIO_INTERNAL_ENDPOINT first (the in-cluster address, e.g. when
#                 the pod and MinIO share a node) and fall back to MINIO_ENDPOINT
#                 (reachable from anywhere); the url handed back is ALWAYS
#                 MINIO_ENDPOINT, because that is the only address a caller can
#                 reach. Both must be set. The URL carries no signature, so this
#                 inherits minio_public's requirements (anonymous s3:GetObject)
#                 and its cannot-be-unpublished caveat.
#   fal           fal.ai CDN; upload returns a PUBLIC url that does not expire,
#                 because retention is fal's account-level policy
# Anything that needs the difference reads StoredObject.visibility, never this
# name. Adding OSS/COS/TOS means a name here and a builder in
# adapter/storage/factory.py -- no script and no engine change.
# Empty MINIO_ENDPOINT (or FAL_KEY under the fal backend) still degrades to a
# data URI; this only selects which backend is asked.
STORAGE_BACKEND=minio
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=adapter-temp
MINIO_SECURE=false
# STORAGE_BACKEND=minio_colocated only, and the single key that switching to it adds:
# the in-cluster address of the same bucket. Uploads try it first (on the same node it is
# a local hop) and fall back to MINIO_ENDPOINT. Enabling this backend is *this line*, not
# a change to MINIO_ENDPOINT -- which keeps meaning "the bucket's reachable address", and
# stays the origin every returned URL is derived from.
#
# Empty means the backend is not configured, and that is reported rather than worked
# around: a pod that lost its in-cluster address would otherwise upload over the public
# address forever and look perfectly healthy.
#
# A scheme may be carried here (http://minio:19000); without one it is plaintext, the
# usual case for an in-cluster hop. MINIO_SECURE describes MINIO_ENDPOINT's transport,
# not this one.
MINIO_INTERNAL_ENDPOINT=
# The connect timeout for that address is a code default (1.0s, deliberately short: it is
# the give-up cost that has to happen before the public address is tried, so the ordinary
# 300s would turn every cross-machine upload into a 300s request instead of a fallback).
# Set MINIO_INTERNAL_CONNECT_TIMEOUT only to deviate.
# Origin for the unsigned URLs STORAGE_BACKEND=minio_public hands out. Empty
# derives it from MINIO_ENDPOINT and MINIO_BUCKET (path style), which is what a
# bare MinIO answers. Set it when the bucket is fronted by a CDN, a custom
# domain, or a gateway that only routes a sub-path -- the derived form would
# name a host the client cannot reach. When set, ping stops checking the bucket
# policy, because the URLs no longer address the bucket.
MINIO_PUBLIC_BASE_URL=
# Optional namespace *inside* the day, for the keys the engine builds:
#   <yyyymmdd>/[<prefix>/]<uuid>.<ext>
# The key carries neither the model nor the request id (settled 2026-09-12): a key becomes
# the URL handed to the caller, and on the unsigned backends whoever holds that URL can read
# it -- so a model name there publishes which model produced the image. Both facts are in the
# trace instead (model via trace_attrs.summarise_request, request_id from request.state).
# The date is always the first segment, so a bucket lifecycle rule can expire a
# day at a time and an upload can be found by when it happened -- and the
# buckets these channels write to are already laid out that way, which is why
# EMPTY IS THE DEFAULT (the date lands at the bucket root: cdn/<yyyymmdd>/...).
# A prefix is a namespace *below* the date (cdn/<date>/gpt-2/...), never in
# front of it: putting it first would push the date out of first position and
# quietly move every upload out of the lifecycle rule's reach.
# "/"-only counts as empty, and cannot produce "<date>//<name>".
# Only the minio flavours see it -- fal has no directories and keeps the
# basename. The date follows the process timezone (UTC in a container unless
# TZ is set).
STORAGE_KEY_PREFIX=

# A second backend, tried when the first cannot take an upload. Empty (the
# default) keeps the previous behaviour: a failing store degrades to a data URI.
#
#   STORAGE_FALLBACK_BACKEND=fal        minio first, fal when minio is down
#
# Two things to know. The fallback needs its own credential (FAL_KEY for fal);
# an unconfigured fallback is reported and ignored, never silently swapped for
# the primary. And failing over changes *what* the caller receives -- the minio
# flavours hand out presigned URLs and fal hands out public ones -- which
# StoredObject.visibility records.
STORAGE_FALLBACK_BACKEND=
# How long the primary is skipped after it fails. A refused connection costs
# about 6s per attempt (five urllib3 retries at the pool settings above), so
# without a park every upload would pay that for as long as the primary is down.
# The health probe deliberately ignores the park and clears it the moment the
# primary answers again.
STORAGE_FAILOVER_COOLDOWN=30
# Lifetime of the presigned URL the minio backend hands out, in SECONDS.
#
# HARD CEILING IS 7 DAYS, NOT 30. minio-py refuses anything outside
# [1s, 604800s] before it signs: "expires must be between 1 second to 7 days"
# (minio/api.py, and the same bound is in the SigV4 spec). Asking for more
# raises ValueError at upload time, which the storage layer turns into a
# silent degradation to a data URI -- the request still succeeds, it just
# stops returning a link. So this is not a value to raise casually.
#
#   TEMP_IMAGE_TTL=3600     1h   (conservative; a leaked URL dies fast)
#   TEMP_IMAGE_TTL=604800   7d   (the maximum minio can presign)
#
# The default here is the 7-day ceiling rather than 1h: clients rarely consume
# the URL immediately (async pipelines, re-processing, a human looking at it
# later), and 1h turns "the link stopped working" into a support ticket. Keep
# it as the ceiling so a fresh deployment behaves like the configured one.
#
# minio therefore CANNOT produce a permanent link at any TTL. If callers must
# be able to fetch the URL longer than this, that is a mechanism change -- a
# backend swap (STORAGE_BACKEND=fal) or unsigned URLs from a public bucket --
# not a larger number here. And both of those expose the object, which the
# presigned URL does not. Pick on the exposure trade-off, not on the clock.
TEMP_IMAGE_TTL=604800
# Per-host HTTP connection pool for object storage. minio-py's own default is
# 10, which sits below the concurrency this service reaches; urllib3 does not
# wait for a free connection, it opens an extra one and discards it on release,
# so an undersized pool silently costs a TCP+TLS handshake per upload -- the
# exact cost sharing the client exists to remove. Size it to roughly the
# uploads expected in flight per worker. Only read when MINIO_ENDPOINT is set.
MINIO_POOL_SIZE=20
# fal.ai CDN credential, used only when STORAGE_BACKEND=fal. Injected into the
# SDK explicitly rather than left to fal-client's own environment lookup, so an
# inherited FAL_KEY cannot silently become the credential this process uploads
# with. Note the object it uploads is PUBLIC by default; restricting it needs a
# storage ACL, not a shorter TTL.
FAL_KEY=

# Timeouts — six independent bounds. Which one fires is reported by the error
# code, so they stay separate rather than merged (AC-27). Only UPSTREAM_TIMEOUT
# bounds waiting on the vendor, so it is the one to raise for a slow model.
#
#   SCRIPT_TIMEOUT          one transform() call           30s   script_timeout
#   UPSTREAM_TIMEOUT        one upstream HTTP call         180s  upstream_timeout
#   POLL_TIMEOUT_DEFAULT    one async job, all its polls   120s  poll_timeout
#   STAGE_BUDGET_DEFAULT    the whole cascade              300s  pipeline_timeout
#                                                       (cap: STAGE_BUDGET_MAX=600)
#   IMAGE_DOWNLOAD_TIMEOUT  one client image fetch         25s   image_download_timeout
#   STORAGE_UPLOAD_TIMEOUT  one object-store upload        25s   storage_upload_timeout
#
# The last two bound one action *inside* a phase, not a phase and not a
# generation. They are short because fetching a reference image is not a
# generation, and they exist so such a failure reports itself instead of
# consuming the phase and surfacing as SCRIPT_TIMEOUT — which names the wrong
# layer. They never replace SCRIPT_TIMEOUT: a phase doing several actions can
# still hit it, and that stays the honest answer for "the script ran too long".
#
# The values with no line below are code defaults (adapter/settings.py); set
# them here only to deviate. Two entries *do* have a line below and are **not**
# code defaults: UPSTREAM_TIMEOUT=180 (code default 60) and
# POLL_TIMEOUT_DEFAULT=120 (code default 300). They are this template's
# proposal for a deployment talking to a slow image model -- the common case,
# and the reason they are set at all. When a line exists, the number below wins;
# the code default is only what you get by deleting that line. A script may override UPSTREAM_TIMEOUT per call via
# ctx.emit(timeout=...), and a cascade still clamps it to the remaining budget.
# Raise it and you must also keep GUNICORN_TIMEOUT and nginx's
# proxy_read_timeout strictly above it, or the client 504s while the upstream
# keeps running and keeps burning quota.
#
# A 2K generation takes 27~82s against the real Ark upstream, so 60s truncates
# slow successes. The shipped .env raises it well past that; this template stays
# at 180 because it is aimed at the mock upstream, where it is harmless.
UPSTREAM_TIMEOUT=180.0
POLL_TIMEOUT_DEFAULT=120.0
POLL_INTERVAL_DEFAULT=2.0
# One poll is a status check, not a generation: it gets its own short bound,
# because POLL_TIMEOUT_DEFAULT is only checked at the top of the loop and a
# single poll allowed to run for UPSTREAM_TIMEOUT would outlive the job budget.
# A script may still ask for more per call via ctx.emit(timeout=...).
POLL_REQUEST_TIMEOUT=10.0

# HTTP client pool — per worker, NOT per deployment.
# The upstream is treated as having unlimited concurrency, so these are local
# resource ceilings rather than a throttle on the vendor.
# Concurrent calls to any one upstream = HTTP_POOL_LIMIT_PER_HOST x workers.
#
# Sized for a target of 1000 concurrent in-flight generations on a 10-worker
# box: per-worker demand = 1000 / 10 = 100, so per-host = 100 puts the box
# ceiling for a single upstream at exactly 1000 and stops self-throttling there.
# HTTP_POOL_LIMIT is the per-worker total across all hosts; it sits above
# per-host because ctx.download_image() (client-supplied image URLs) draws from
# the same pool while an upstream call is in flight.
#
# Overflow queues in the connector rather than failing, but the wait counts
# against aiohttp's total timeout (UPSTREAM_TIMEOUT), so a saturated pool shows
# up as 504s instead of a clean rejection.
#
# Memory, not sockets, is the binding budget: each in-flight request holds its
# whole upstream response, so peak RSS ~= concurrency x response size — 2~4 MB
# for one 2K image, 10~30 MB for a layer-decomposition reply. MAX_UPSTREAM_BYTES
# is what keeps that product finite, so size the host for the expected average
# rather than for whatever a vendor might send. gunicorn WORKER_CONNECTIONS
# (1000/worker) is an order of magnitude above this and is not the limit that
# bites.
HTTP_POOL_LIMIT=150
HTTP_POOL_LIMIT_PER_HOST=100

# FANOUT_CONCURRENCY caps a different thing: how many per-item calls one
# request's materialisation may have in flight (ctx.fanout -- fetching the
# client's N references, retrieving N reply items, N storage uploads). It is not
# a pool setting, so do not tune it by the pool's reasoning.
#
# Five, and note what does NOT bound a useful value here: an earlier version of
# this comment claimed SCRIPT_TIMEOUT would arrive first and a larger cap would
# buy nothing. Measured 2026-09-13 against a latency-limited source, N=9 went
# from 927 ms at 3 to 368 ms at 9 (2.5x) with the phase budget never approached.
# The real ceilings are upstream behaviour, memory (fanout_concurrency x
# MAX_ASSET_BYTES worst case) and HTTP_POOL_LIMIT_PER_HOST, whose queue wait is
# charged to the action's own timeout.
#
# The width actually used is min(configured, N), so a one-reference request
# never builds the semaphore and a text-to-image request never fans out at all:
# a value at or below the degree is free, not merely cheap.
FANOUT_CONCURRENCY=5

# Hard ceiling on one upstream response body. A larger reply is refused with
# 502 upstream_body_too_large instead of being buffered. The default leaves
# headroom for a layer-decomposition reply (up to 11 images, 10~30 MB) and for
# the 4/3 inflation of base64 image payloads.
MAX_UPSTREAM_BYTES=67108864

# Hard ceiling on ONE inbound request body. The adapter enforces this itself
# (413 request_too_large) because it cannot assume a reverse proxy is in front
# of it: Starlette's Request.body() and Request.form() accumulate with no
# ceiling, and the multipart route reads up to 64 files into memory. A proxy
# should also set client_max_body_size to the same value -- that refuses the
# body before it reaches this process at all, which is strictly cheaper. See
# deploy/nginx.conf.example.
#
# Size it for the JSON routes: base64 inflates an upload by 4/3, so a 20 MB
# image is ~27 MB on the wire, times the number of references per request.
MAX_REQUEST_BYTES=67108864

# Admission control（X-Adapter-Key 门禁）
# 字段名是 ADAPTER_KEY / ADAPTER_KEY_REQUIRED，不是 ADAPTER_AUTH_*。
# ADAPTER_KEY_REQUIRED 默认 true；此时 ADAPTER_KEY 若为空，所有请求一律 401。
# 内联脚本即远程代码执行，生产环境必须设 ADAPTER_KEY 而不是关掉门禁。
ADAPTER_KEY_REQUIRED=false
ADAPTER_KEY=

# Rate Limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ALLOW_ORIGINS=*

# Observability (optional; leave blank for local-only mode)
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=openai-adapter
# Blank = resolve from installed distribution metadata, then pyproject.toml.
# A container deployment should also leave this blank: the image bakes the
# released version in via --build-arg APP_VERSION (see Dockerfile), and
# env_file would override that baked value if this were set here.
LOGFIRE_SERVICE_VERSION=
# Head sampling ratio for traces; 1.0 traces every request
LOGFIRE_SAMPLE_RATE=1.0
# Human-readable span output on stderr; set false in production
LOGFIRE_CONSOLE=true
# Comma-separated paths excluded from tracing. /health is probed on a timer
# by every orchestrator and would otherwise bury the traffic that matters.
LOGFIRE_EXCLUDED_URLS=/health
# DANGER: captures request headers, which on this service include
# X-Adapter-Key (data-plane credential), Authorization (vendor credential)
# and X-Script (executable source). Leave false unless scrubbing rules exist.
LOGFIRE_CAPTURE_HEADERS=false
# Scrubbing is deliberately not configurable: the policy lives in
# adapter/logfire_setup.py, so no deployment can lose it by omitting a line.
# Every value is exported verbatim except api-key names (api_key, authorization,
# x-adapter-key, x-auth-emit, x-script, the logfire token), and those only where
# the name is the attribute itself or reads as `name: value` / `name=value` --
# so a prompt mentioning "api key" survives while `?api_key=...` does not.
# Turning the header capture above on makes init_logfire raise rather than
# export, since X-Auth-Emit names the credential header per channel.
#
# The batch export interval is hardcoded there too: OTEL_BSP_SCHEDULE_DELAY=5000
# against logfire's own 500 ms default, which cuts the export request count by
# roughly 10x. lifespan's flush_spans() drains the queue on shutdown, and that
# flush is what makes the longer interval safe -- the batch exporter is a daemon
# thread with no atexit hook, so spans still queued would otherwise be dropped on
# every restart. OTEL_BSP_MAX_QUEUE_SIZE (2048) and MAX_EXPORT_BATCH_SIZE (512)
# stay at the OTel defaults; OTEL_BSP_EXPORT_TIMEOUT is inert -- OTel stores it
# and never passes it to export -- so setting it would look like a bound that
# does not exist.

# 上游凭据不从这里读取。适配器不持有上游密钥：脚本无法访问进程环境
# （见 adapter/context.py 模块注释），凭据由控制面随请求经 channel header 传入
# （Authorization / X-Auth-Emit）。
# 下面这个仅供人工用 curl 直连火山方舟时 source 使用，适配器本身不消费。
VOLCENGINE_ARK_API_KEY=

# --- gunicorn（仅容器内生效，见 gunicorn.conf.py）-------------------------
# 这些不是 Settings 字段，适配器进程不读；由 gunicorn 启动时读取。
#
# WEB_CONCURRENCY 必须写死。留空或填非法值都不等于 1：gunicorn.conf.py 的
# _int_env 会回落到「CPU 核数」，也就是多 worker。多 worker 下必须配
# REDIS_URL，否则 /v1/responses 状态链跨 worker 静默断裂。
WEB_CONCURRENCY=10
# worker 存活看门狗。它**不是**「各项超时之和」的预算，而是「一个 worker 卡多久就回收」
# 的阈值 —— 无界的病态组合本不该指望它兜。取值须满足三条：
#   ① 大于单次上游调用（UPSTREAM_TIMEOUT=180），否则慢生成被 SIGKILL 成 502；
#   ② 大于最慢的单个相位（SCRIPT_TIMEOUT=30），否则慢相位同样被杀；
#   ③ 大于「一次调用 + 一个相位」＝ 180 + 30 = 210，即 UPSTREAM_TIMEOUT + SCRIPT_TIMEOUT。
# 取 300（2026-09-13 定策：**只按「一次调用 + 一个相位」定尺度，不把重试算进来**；
# 与部署侧 .env 取 600 同一口径）。
# 🔴 旧式子 `2×(UPSTREAM+SCRIPT)=420` **已废弃，两头都不对**：重试的前提是第一发回 4xx
#    （「请求被拒、什么都没跑」，秒级）⇒ `2×UPSTREAM` 不可达；而「各含一个相位」又漏了
#    response。按**结构**记忆：相位与调用**交替相加**（`auth? → request → 调用 → response`）；
#    单次尝试的上限＝180 + 2×30 = 240（本模板），属极端组合，**不承诺覆盖**。
# ⚠️ UPSTREAM_TIMEOUT 或 SCRIPT_TIMEOUT 一经改动，本值必须重算
#    （定式：`GUNICORN_TIMEOUT > UPSTREAM_TIMEOUT + SCRIPT_TIMEOUT`，不计重试）；
#    且 nginx 的 proxy_read_timeout 必须**严格大于**本值（deploy/nginx.conf.example 为 1200s）。
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=120
# 单 worker 并发连接上限；真正的节流是 HTTP_POOL_LIMIT_PER_HOST。
WORKER_CONNECTIONS=1000
