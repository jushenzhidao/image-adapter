# Environment variables for the adapter (copy to .env for local dev)

# Deployment
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080

# Infrastructure — optional accelerators, empty = in-process fallback.
# REDIS_URL is one switch across three states:
#   redis://redis:6379/0   -> the built-in redis service in compose (default)
#   redis://<host>:6379/0  -> an external / managed redis
#   empty                  -> state chain + asset cache live in the worker
#                             (single-node only: workers do NOT share state)
# Required as soon as WEB_CONCURRENCY > 1: with no shared store the
# /v1/responses state chain breaks silently across workers. A configured but
# unreachable host now degrades to the in-process fallback (30s backoff)
# instead of failing requests, so it is survivable -- but leaving it empty is
# still the honest choice when you run a single worker.
# MINIO_ENDPOINT empty -> ctx.image_url() returns a data URI instead of a
#                         presigned public URL
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=adapter-temp
MINIO_SECURE=false

# Timeouts
# A 2K generation takes 27~82s against the real Ark upstream, so 60s truncates
# slow successes. Kept at 180 for parity with the shipped .env; harmless when
# pointed at the mock upstream.
UPSTREAM_TIMEOUT=180.0
POLL_TIMEOUT_DEFAULT=120.0
POLL_INTERVAL_DEFAULT=2.0

# HTTP client pool — per worker, NOT per deployment.
# The upstream is treated as having unlimited concurrency, so these are local
# resource ceilings rather than a throttle on the vendor.
# Concurrent calls to any one upstream = HTTP_POOL_LIMIT_PER_HOST x workers.
#
# Sized for a target of 1000 concurrent in-flight generations on a 10-worker
# box: per-worker demand = 1000 / 10 = 100, so per-host = 100 puts the box
# ceiling for a single upstream at exactly 1000 and stops self-throttling there.
# HTTP_POOL_LIMIT is the per-worker total across all hosts; it sits above
# per-host because ctx.download_image() (client-supplied image URLs) draws from
# the same pool while an upstream call is in flight.
#
# Overflow queues in the connector rather than failing, but the wait counts
# against aiohttp's total timeout (UPSTREAM_TIMEOUT), so a saturated pool shows
# up as 504s instead of a clean rejection.
#
# Memory, not sockets, is the binding budget: the whole upstream response is
# read with a single resp.read() (not streamed), so peak RSS ~= concurrency x
# response size — 2~4 MB for one 2K image, 10~30 MB for a layer-decomposition
# reply. 1000 concurrent x ~8 MB average is ~8~10 GB. Size the host for that, or
# scale both values down. gunicorn WORKER_CONNECTIONS (1000/worker) is an order
# of magnitude above this and is not the limit that bites.
HTTP_POOL_LIMIT=150
HTTP_POOL_LIMIT_PER_HOST=100

# Admission control（X-Adapter-Key 门禁）
# 字段名是 ADAPTER_KEY / ADAPTER_KEY_REQUIRED，不是 ADAPTER_AUTH_*。
# ADAPTER_KEY_REQUIRED 默认 true；此时 ADAPTER_KEY 若为空，所有请求一律 401。
# 内联脚本即远程代码执行，生产环境必须设 ADAPTER_KEY 而不是关掉门禁。
ADAPTER_KEY_REQUIRED=false
ADAPTER_KEY=

# Rate Limit
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ALLOW_ORIGINS=*

# Observability (optional; leave blank for local-only mode)
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=openai-adapter
# Blank = resolve from installed distribution metadata, then pyproject.toml.
# A container deployment should also leave this blank: the image bakes the
# released version in via --build-arg APP_VERSION (see Dockerfile), and
# env_file would override that baked value if this were set here.
LOGFIRE_SERVICE_VERSION=
# Head sampling ratio for traces; 1.0 traces every request
LOGFIRE_SAMPLE_RATE=1.0
# Human-readable span output on stderr; set false in production
LOGFIRE_CONSOLE=true
# Comma-separated paths excluded from tracing. /health is probed on a timer
# by every orchestrator and would otherwise bury the traffic that matters.
LOGFIRE_EXCLUDED_URLS=/health
# DANGER: captures request headers, which on this service include
# X-Adapter-Key (data-plane credential), Authorization (vendor credential)
# and X-Script (executable source). Leave false unless scrubbing rules exist.
LOGFIRE_CAPTURE_HEADERS=false

# 上游凭据不从这里读取。适配器不持有上游密钥：脚本无法访问进程环境
# （见 adapter/context.py 模块注释），凭据由控制面随请求经 channel header 传入
# （Authorization / X-Auth-Emit）。
# 下面这个仅供人工用 curl 直连火山方舟时 source 使用，适配器本身不消费。
VOLCENGINE_ARK_API_KEY=

# --- gunicorn（仅容器内生效，见 gunicorn.conf.py）-------------------------
# 这些不是 Settings 字段，适配器进程不读；由 gunicorn 启动时读取。
#
# WEB_CONCURRENCY 必须写死。留空或填非法值都不等于 1：gunicorn.conf.py 的
# _int_env 会回落到「CPU 核数」，也就是多 worker。多 worker 下必须配
# REDIS_URL，否则 /v1/responses 状态链跨 worker 静默断裂。
WEB_CONCURRENCY=10
# worker 存活看门狗，必须大于 UPSTREAM_TIMEOUT，否则慢生成会被 SIGKILL 成 502。
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=120
# 单 worker 并发连接上限；真正的节流是 HTTP_POOL_LIMIT_PER_HOST。
WORKER_CONNECTIONS=1000
