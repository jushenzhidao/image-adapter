# Environment variables for the adapter (copy to .env for local dev)

# Deployment
ENVIRONMENT=dev
HOST=0.0.0.0
PORT=8080

# Infrastructure (empty = dev degradation)
REDIS_URL=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=adapter-temp
MINIO_SECURE=false

# Paths
SCRIPT_PATH=scripts
UPSTREAMS_CONFIG_PATH=config/upstreams.yaml

# Timeouts
SANDBOX_TIMEOUT=30.0
UPSTREAM_TIMEOUT=60.0
POLL_TIMEOUT_DEFAULT=120.0
POLL_INTERVAL_DEFAULT=2.0

# Auth / Rate Limit
ADAPTER_AUTH_ENABLED=false
ADAPTER_AUTH_TOKEN=
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ALLOW_ORIGINS=*

# Observability (optional; leave blank for local-only mode)
LOGFIRE_TOKEN=

# Upstream credentials (for scripts via ctx.env)
UPSTREAM_A_API_KEY=mock-key-a
UPSTREAM_B_AK=test-ak
UPSTREAM_B_SK=test-sk
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_API_KEY=
